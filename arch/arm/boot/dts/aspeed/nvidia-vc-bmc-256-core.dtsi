/dts-v1/;

#include "aspeed-g6.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>

&gpio0 {
    gpio-line-names =

    /* gpio-line-names are the combination of <signal>-<I/O> , "" is the placeholder for the unused pins*/

    /* 208 (26*8) 3.3V GPIOs */

    /*A0-A7*/
    "", "", "", "", "", "", "", "",

    /*B0-B7*/
    "", "", "", "", "", "", "", "",

    /*C0-C7*/
    "SGPIO_I2C_MUX_SEL-O",
    "", "", "", "", "", "", "",

    /*D0-D7*/
    "", "", "",
    "UART1_MUX_SEL-O",
    "",
    "FPGA_PEX_RST_L-O",
    "", "",

    /*E0-E7*/
    "RTL8221_PHY_RST_L-O",
    "RTL8211_PHY_INT_L-I",
    "",
    "UART3_MUX_SEL-O",
    "", "", "",
    "SGPIO_BMC_EN-O",

    /*F0-F7*/
    "", "", "", "", "", "", "", "",

    /*G0-G7*/
    "", "", "", "", "", "", "", "",

    /*H0-H7*/
    "", "", "", "", "", "", "", "",

    /*I0-I7*/
    "", "", "", "", "",
    "QSPI2_RST_L-O",
    "GLOBAL_WP_BMC-O",
    "BMC_DDR4_TEN-O",

    /*J0-J7*/
    "", "", "", "", "", "", "", "",

    /*K0-K7*/
    "", "", "", "", "", "", "", "",

    /*L0-L7*/
    "", "", "", "", "", "", "", "",

    /*M0-M7*/
    "PCIE_EP_RST_EN-O",
    "BMC_FRU_WP-O",
    "HMC_RESET_L-O",
    "STBY_POWER_EN-O",
    "STBY_POWER_PG-I",
    "PCIE_EP_RST_L-O",
    "", "",

    /*N0-N7*/
    "", "", "", "", "", "", "", "",

    /*O0-O7*/
    "", "", "", "", "", "", "", "",

    /*P0-P7*/
    "", "", "", "", "", "", "", "",

    /*Q0-Q7*/
    "", "", "", "", "", "", "", "",

    /*R0-R7*/
    "", "", "", "", "", "", "", "",

    /*S0-S7*/
    "", "", "", "", "", "", "", "",

    /*T0-T7*/
    "", "", "", "", "", "", "", "",

    /*U0-U7*/
    "", "", "", "", "", "", "", "",

    /*V0-V7*/
    "AP_EROT_REQ-O",
    "EROT_AP_GNT-I",
    "",
    "",
    "PCB_TEMP_ALERT-I",
    "", "", "",

    /*W0-W7*/
    "", "", "", "", "", "", "",
    "CPU_RST_L-I",

    /*X0-X7*/
    "", "",
    "TPM_MUX_SEL-O",
    "", "", "", "", "",

    /*Y0-Y7*/
    "", "", "",
    "EMMC_RST-O",
    "","", "", "",

    /*Z0-Z7*/
    "","", "", "", "", "", "", "";
};

&gpio1 {
    /* 36 1.8V GPIOs */
    gpio-line-names =
    /*A0-A7*/
    "", "", "", "", "", "", "", "",

    /*B0-B7*/
    "", "", "", "",
    "AP_EROT_REQ-O",
    "EROT_AP_GNT-I",
    "IO_EXPANDER_INT_L-I",
    "",

    /*C0-C7*/
    "", "", "", "", "", "", "", "",

    /*D0-D7*/
    "", "", "", "", "", "", "",
    "I2C_SSIF_ALERT_L-I",

    /*E0-E7*/
    "", "", "", "", "", "", "", "";
};

// I2C2 GPIO Expander
&i2c1 {
    // E1.S BOARD, Expander @0x20
    exp0: pca6408@20 {
        compatible = "nxp,pca6408";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;

        gpio-line-names =
            "MCU_RESET",
            "MCU_RECOVERY",
            "P12V_P3V3_EXP_PG",
            "HSBP_TEMP_ALERT_N",
            "MCU_I2C_ISO_EN_N",
            "",
            "LOWER_PERST",
            "UPPER_PERST";
    };
};

// I2C3 GPIO Expander
&i2c2 {
    // MGMT0 BOARD, Expander @0x20
    exp1: pca9555@20 {
        compatible = "nxp,pca9555";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;

        #address-cells = <1>;
        #size-cells = <0>;
        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;

        gpio-line-names =
            "SHDN_FORCE_L",
            "STBY_PWR_PG",
            "THERM_OVERT_L",
            "THERM_WARN_L",
            "GLOBAL_WP",
            "USB0_HUB_RST_L",
            "IOX_PRE_SYS_RST_N",
            "LEAK_DETECT_ALERT_L",
            "RUN_PWR_EN",
            "MODULE_PWR_GOOD",
            "CPU_CHIPTHROT_L_3V3",
            "SHDN_REQ_L_3V3",
            "CPU_SHDN_OK_L_3V3",
            "CPLD_READY",
            "PWR_BRAKE_L_3V3",
            "PWR_BRAKE_L_STATUS";
    };

    // MGMT0 BOARD, Expander @0x21
    exp2: pca9555@21 {
        compatible = "nxp,pca9555";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;

        #address-cells = <1>;
        #size-cells = <0>;
        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;

        gpio-line-names =
            "I2C_BUS_MUX_RST_L",
            "HPM_MCU_OK",
            "CPU_SYS_RST_N_3V3",
            "C0_SOCAMM_DAC_I2C_SEL_R",
            "C1_SOCAMM_DAC_I2C_SEL_R",
            "C0_SOCAMM_I2C_SEL",
            "C1_SOCAMM_I2C_SEL",
            "EEPROM_POWER_DISABLE",
            "CPU_L0L1_RST_L_3V3",
            "CPU_L2_RST_L_3V3",
            "BRD_ID_0",
            "BRD_ID_1",
            "BMC_LEAK_TEST_L",
            "MCU_BMC_ALERT_L",
            "CPU_BOOT_COMPLETE_3V3",
            "";
    };

    // MGMT0 BOARD, Expander @0x22
    exp3: pca9555@22 {
        compatible = "nxp,pca9555";
        reg = <0x22>;
        gpio-controller;
        #gpio-cells = <2>;

        #address-cells = <1>;
        #size-cells = <0>;
        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;
        gpio-line-names =
            "MCU_RESET_L",
            "MCU_RECOVERY_L",
            "I2C_SOCAMM_UPHY_SEL",
            "SNN_GPU0_MCU_REC_L",
            "",
            "",
            "HMC_IST_PRE_RST_L",
            "",
            "",
            "",
            "",
            "",
            "",
            "SNN_BOARD_LOC_STRAP",
            "IST_SYS_RST_L",
            "";
    };

    // MGMT0 BOARD, Expander @0x23
    exp4: pca9555@23 {
        compatible = "nxp,pca9555";
        reg = <0x23>;
        gpio-controller;
        #gpio-cells = <2>;

        #address-cells = <1>;
        #size-cells = <0>;
        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;
        gpio-line-names =
            "CPU_FORCED_RECOVERY_L",
            "CPU_BOOT_DEV_SEL0",
            "CPU_BOOT_DEV_SEL1",
            "CPU_BOOT_DEV_SEL2",
            "HMC_BRD_ID0",
            "CPU_RECOVERY_TYPE0",
            "CPU_RECOVERY_TYPE1",
            "CPU_IST_BOOT_HMC",
            "CPU_BOOT_CHAIN0",
            "HMC_BRD_ID1",
            "HPM_MCU_I2C_ENABLE",
            "CPU_DIE_SEL0",
            "CPU_DIE_SEL1",
            "CPU_DIE_SEL2",
            "",
            "IOX_JTAG_NVSEL";
    };

    // MGMT0 BOARD, Expander @0x24
    exp5: pca9555@24 {
        compatible = "nxp,pca9555";
        reg = <0x24>;
        gpio-controller;
        #gpio-cells = <2>;

        #address-cells = <1>;
        #size-cells = <0>;
        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;
        gpio-line-names =
            "C0_UPHY0_PRSNT0_L",
            "C0_UPHY0_PRSNT1_L",
            "C0_UPHY2_PRSNT0_L",
            "C0_UPHY2_PRSNT1_L",
            "C0_UPHY3_PRSNT0_L",
            "C1_UPHY0_PRSNT0_L",
            "C1_UPHY0_PRSNT1_L",
            "C1_UPHY2_PRSNT0_L",
            "C1_UPHY2_PRSNT1_L",
            "C1_UPHY3_PRSNT0_L",
            "PU_NOTUSED_Cx_PRSNT_P10_L",
            "PU_NOTUSED_Cx_PRSNT_P11_L",
            "PU_NOTUSED_Cx_PRSNT_P12_L",
            "PU_NOTUSED_Cx_PRSNT_P13_L",
            "PU_NOTUSED_Cx_PRSNT_P14_L",
            "PU_NOTUSED_Cx_PRSNT_P15_L";
    };
};

// I2C6 GPIO Expander
&i2c5 {
    // SMM Carrier, Expander @0x20
    exp6: pca9555@20 {
        compatible = "nxp,pca9555";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;

        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;
        gpio-line-names =
            "",
            "",
            "",
            "GLOBAL_WP",
            "",
            "",
            "BMC_SELF_PWR_CYCLE",
            "EEDO_LED2",
            "",
            "",
            "",
            "",
            "",
            "USB2_HUB_RST_L",
            "USB2_BMC_HUB2_RST_L",
            "";
    };

    // SMM Carrier, Expander @0x21
    exp7: pca9555@21 {
        compatible = "nxp,pca9555";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;

        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;
        gpio-line-names =
            "",
            "BMC_TPM_MUX_SEL",
            "BMC_USB2_MUX_SEL",
            "",
            "",
            "HDR_SPI_PRSNT_L",
            "SW_NRESET_R_L",
            "",
            "I2C_BUS_MUX_RESET_L",
            "USB_MUX_EN_L",
            "PDB_TRAY_RST",
            "HOST_RDY_PWR_EN",
            "RTC_CLR_L",
            "I2C_RTC_ALERT_L",
            "X86_MUX_TPM_RST_SEL",
            "BMC_MUX_PI3DP_SEL";
    };
};

// I2C7 GPIO Expander
&i2c6 {
    // BMC IO Expander @0x20
    exp8: pca6408@20 {
        compatible = "nxp,pca6408";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;

        gpio-line-names =
            "",
            "",
            "EROT_FATAL_ERROR_N",
            "",
            "",
            "EROT_RECOV_N",
            "NRESET_IN_IOX_N",
            "";
    };
};

// EMMC group that excludes WP & CD pin
&pinctrl {
    pinctrl_emmcg9_default: emmcg9_default {
        function = "EMMC";
        groups = "EMMCG9";
    };
};

