/dts-v1/;

#include "aspeed-g6.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>

&gpio0 {
    gpio-line-names =

    /* gpio-line-names are the combination of <signal>-<I/O> , "" is the placeholder for the unused pins*/

    /* 208 (26*8) 3.3V GPIOs */

    /*A0-A7*/
    "", "", "", "", "", "", "", "",

    /*B0-B7*/
    "", "", "", "", "", "", "", "",

    /*C0-C7*/
    "SGPIO_I2C_MUX_SEL-O",
    "", "", "", "", "", "", "",

    /*D0-D7*/
    "", "", "",
    "UART1_MUX_SEL-O",
    "",
    "FPGA_PEX_RST_L-O",
    "", "",

    /*E0-E7*/
    "RTL8221_PHY_RST_L-O",
    "RTL8211_PHY_INT_L-I",
    "",
    "UART3_MUX_SEL-O",
    "", "", "",
    "SGPIO_BMC_EN-O",

    /*F0-F7*/
    "", "", "", "", "", "", "", "",

    /*G0-G7*/
    "", "", "", "", "", "", "", "",

    /*H0-H7*/
    "", "", "", "", "", "", "", "",

    /*I0-I7*/
    "", "", "", "", "",
    "QSPI2_RST_L-O",
    "GLOBAL_WP_BMC-O",
    "BMC_DDR4_TEN-O",

    /*J0-J7*/
    "", "", "", "", "", "", "", "",

    /*K0-K7*/
    "", "", "", "", "", "", "", "",

    /*L0-L7*/
    "", "", "", "", "", "", "", "",

    /*M0-M7*/
    "PCIE_EP_RST_EN-O",
    "BMC_FRU_WP-O",
    "HMC_RESET_L-O",
    "STBY_POWER_EN-O",
    "STBY_POWER_PG-I",
    "PCIE_EP_RST_L-O",
    "", "",

    /*N0-N7*/
    "", "", "", "", "", "", "", "",

    /*O0-O7*/
    "", "", "", "", "", "", "", "",

    /*P0-P7*/
    "", "", "", "", "", "", "", "",

    /*Q0-Q7*/
    "", "", "", "", "", "", "", "",

    /*R0-R7*/
    "", "", "", "", "", "", "", "",

    /*S0-S7*/
    "", "", "", "", "", "", "", "",

    /*T0-T7*/
    "", "", "", "", "", "", "", "",

    /*U0-U7*/
    "", "", "", "", "", "", "", "",

    /*V0-V7*/
    "AP_EROT_REQ-O",
    "EROT_AP_GNT-I",
    "",
    "",
    "PCB_TEMP_ALERT-I",
    "", "", "",

    /*W0-W7*/
    "", "", "", "", "", "", "",
    "CPU_RST_L-I",

    /*X0-X7*/
    "", "",
    "TPM_MUX_SEL-O",
    "", "", "", "", "",

    /*Y0-Y7*/
    "", "", "",
    "EMMC_RST-O",
    "","", "", "",

    /*Z0-Z7*/
    "","", "", "", "", "", "", "";
};

&gpio1 {
    /* 36 1.8V GPIOs */
    gpio-line-names =
    /*A0-A7*/
    "", "", "", "", "", "", "", "",

    /*B0-B7*/
    "", "", "", "",
    "AP_EROT_REQ-O",
    "EROT_AP_GNT-I",
    "IO_EXPANDER_INT_L-I",
    "",

    /*C0-C7*/
    "", "", "", "", "", "", "", "",

    /*D0-D7*/
    "", "", "", "", "", "", "",
    "I2C_SSIF_ALERT_L-I",

    /*E0-E7*/
    "", "", "", "", "", "", "", "";
};

// I2C2 GPIO Expander
&i2c1 {
    // E1.S Storage Backplane, Expander @0x20
    exp0: pca6408@20 {
        compatible = "nxp,pca6408";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;

        vcc-supply = <&standby_power_regulator>;
        gpio-line-names =
            "E1S_MCU_RESET_L-O",
            "E1S_MCU_RECOVERY_L-O",
            "",
            "E1S_TEMP_ALERT_L-I",
            "E1S_PMB_ALERT_L-I",
            "",
            "E1S_LOWER_PERST-O",
            "";
    };
};

// I2C3 GPIO Expander
&i2c2 {
    // MGMT0 BOARD, Expander @0x20
    exp1: pca9555@20 {
        compatible = "nxp,pca9555";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;

        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;

        gpio-line-names =
            "B0_M0_SHDN_FORCE_L-O",
            "B0_M0_STBY_PWR_PG-I",
            "B0_M0_THERM_OVERT_L-I",
            "B0_M0_THERM_WARN_L-I",
            "B0_M0_GLOBAL_WP-O",
            "B0_M0_USB0_HUB_RST_L-O",
            "B0_M0_IOX_PRE_SYS_RST_N-O",
            "B0_M0_LEAK_DETECT_ALERT_L-I",
            "B0_M0_RUN_PWR_EN-O",
            "B0_M0_MODULE_PWR_GOOD-I",
            "B0_M0_CPU_CHIPTHROT_L_3V3-I",
            "B0_M0_SHDN_REQ_L_3V3-O",
            "B0_M0_CPU_SHDN_OK_L_3V3-I",
            "B0_M0_CPLD_READY-I",
            "B0_M0_PWR_BRAKE_L_3V3-O",
            "B0_M0_PWR_BRAKE_L_STATUS-I";
    };

    // MGMT0 BOARD, Expander @0x21
    exp2: pca9555@21 {
        compatible = "nxp,pca9555";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;

        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;

        gpio-line-names =
            "B0_M0_MCU_RESET_L-O",
            "B0_M0_HPM_MCU_OK-I",
            "B0_M0_CPU_SYS_RST_N_3V3-I",
            "B0_M0_C0_SOCAMM_DAC_I2C_SEL_R-O",
            "B0_M0_C1_SOCAMM_DAC_I2C_SEL_R-O",
            "B0_M0_C0_SOCAMM_I2C_SEL-O",
            "B0_M0_C1_SOCAMM_I2C_SEL-O",
            "B0_M0_EEPROM_POWER_DISABLE-O",
            "B0_M0_CPU_L0L1_RST_L_3V3-I",
            "B0_M0_CPU_L2_RST_L_3V3-I",
            "B0_M0_BRD_ID_0-I",
            "B0_M0_BRD_ID_1-I",
            "B0_M0_BMC_LEAK_TEST_L-O",
            "B0_M0_MCU_BMC_ALERT_L-I",
            "B0_M0_CPU_BOOT_COMPLETE_3V3-I",
            "B0_M0_MCU_RECOVERY_L-O";
    };

    // MGMT0 BOARD, Expander @0x23
    exp3: pca9555@23 {
        compatible = "nxp,pca9555";
        reg = <0x23>;
        gpio-controller;
        #gpio-cells = <2>;

        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;
        gpio-line-names =
            "B0_M0_CPU_FORCED_RECOVERY_L-O",
            "B0_M0_CPU_BOOT_DEV_SEL0-O",
            "B0_M0_CPU_BOOT_DEV_SEL1-O",
            "B0_M0_CPU_BOOT_DEV_SEL2-O",
            "B0_M0_HMC_BRD_ID0-I",
            "B0_M0_CPU_RECOVERY_TYPE0-O",
            "B0_M0_CPU_RECOVERY_TYPE1-O",
            "B0_M0_CPU_IST_BOOT_HMC-O",
            "B0_M0_CPU_PREBOOT_DIAG-O",
            "B0_M0_HMC_BRD_ID1-I",
            "B0_M0_HPM_MCU_I2C_ENABLE-O",
            "B0_M0_CPU_DIE_SEL0-O",
            "B0_M0_CPU_DIE_SEL1-O",
            "B0_M0_CPU_DIE_SEL2-O",
            "B0_M0_CPLD_AUTH_FAIL_L_1V8-I",
            "B0_M0_IOX_JTAG_NVSEL-O";
    };
};

// I2C6 GPIO Expander
&i2c5 {
    // Baseboard (with SMM), Expander @0x20
    exp4: pca9555@20 {
        compatible = "nxp,pca9555";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;

        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;
        gpio-line-names =
            "",
            "8373_INT_N-O",
            "P12V_STBY_PG-I",
            "GLOBAL_WP-O",
            "",
            "STBY_ETH_PG-I",
            "BMC_SELF_PWR_CYCLE-O",
            "EEDO_1_LED2-O",
            "",
            "",
            "P1V8_PG-I",
            "P1V05_PG-I",
            "",
            "USB2_HUB_RST_L-O",
            "",
            "";
    };

    // Baseboard (with SMM), Expander @0x21
    exp5: pca9555@21 {
        compatible = "nxp,pca9555";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;

        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;
        gpio-line-names =
            "U8367_LINK_BF4_GOOD-I",
            "BMC_TPM_MUX_SEL-O",
            "BOARD_ID_0-I",
            "BOARD_ID_1-I",
            "",
            "HDR_SPI_PRSNT_L-I",
            "",
            "P54V_HSC_PG-I",
            "I2C_BUS_MUX_RESET_L-O",
            "",
            "PDB_TRAY_RST-O",
            "HOST_RDY_PWR_EN-I",
            "RTC_CLR_L-O",
            "I2C_RTC_ALERT_L-I",
            "X86_MUX_TPM_RST_SEL-O",
            "";
    };
};

// I2C7 GPIO Expander
&i2c6 {
    // BMC IO Expander @0x20
    exp6: tca6408@20 {
        compatible = "ti,tca6408";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;

        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;

        gpio-line-names =
            "",
            "",
            "EROT_FATAL_ERROR_N",
            "",
            "",
            "EROT_RECOV_N",
            "NRESET_IN_IOX_N",
            "";
    };
};

// EMMC group that excludes WP & CD pin
&pinctrl {
    pinctrl_emmcg9_default: emmcg9_default {
        function = "EMMC";
        groups = "EMMCG9";
    };
};
