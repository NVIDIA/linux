/dts-v1/;

#include "nvidia-vc-bmc-cmx-core.dtsi"
#include <dt-bindings/i2c/i2c.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "AST2600 NVIDIA CMX BMC";
	compatible = "aspeed,ast2600";

	aliases {
		serial2 = &uart3;
		serial4 = &uart5;

		i2c132 = &osfp_u3_cp2112_i2c;
		i2c133 = &osfp_u59_cx0_i2c;
		i2c134 = &midplane_u155_cp2112_i2c;
		i2c135 = &osfp_u59_cx1_i2c;
	};

	chosen {
		/* The OF console parser expects a path or alias string with options. */
		stdout-path = "serial4:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x80000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		vga_memory: framebuffer@9f000000 {
			no-map;
			reg = <0x9f000000 0x01000000>; /* 16M */
		};

		ramoops@a0000000 {
			compatible = "ramoops";
			reg = <0xa0000000 0x100000>; /* 1MB */
			record-size = <0x10000>; /* 64KB */
			max-reason = <2>; /* KMSG_DUMP_OOPS */
		};

		gfx_memory: framebuffer {
			size = <0x01000000>;
			alignment = <0x01000000>;
			compatible = "shared-dma-pool";
			reusable;
		};

		video_engine_memory: jpegbuffer {
			size = <0x02000000>;	/* 32M */
			alignment = <0x01000000>;
			compatible = "shared-dma-pool";
			reusable;
		};
	};

	leds {
		compatible = "gpio-leds";
		uid_led {
			gpios = <&smm_u73_gpio 10 GPIO_ACTIVE_LOW>;
		};
		fault_led {
			gpios = <&smm_u73_gpio 12 GPIO_ACTIVE_LOW>;
		};
		power_led {
			gpios = <&smm_u73_gpio 8 GPIO_ACTIVE_LOW>;
		};
	};

	buttons {
		power-btn {
			gpio = <&smm_u73_gpio 9 GPIO_ACTIVE_LOW>;
		};
		uid-btn {
			gpio = <&smm_u73_gpio 11 GPIO_ACTIVE_LOW>;
		};
	};

};

/* Enabled Primary flash on FMC for bring up activity */
&fmc {
	status = "okay";
	flash@0 {
		status = "okay";
		compatible = "jedec,spi-nor";
		label = "bmc";
		spi-max-frequency = <50000000>;
#include "aspeed-bmc-nvidia-gh-flash-layout-64.dtsi"
	};
};

&fmcraw {
	status = "okay";
	spidev@0 {
		compatible = "mctp-spi";
		alert-gpio = <&gpio0 ASPEED_GPIO(R, 1) GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&gpio0 ASPEED_GPIO(R, 1) IRQ_TYPE_LEVEL_HIGH>;
		status = "okay";
	};
};

&spi1raw {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi1_default>;
	spidev@0 {
		spi-max-frequency = <25000000>;
		compatible = "hgx,glacier";
		status = "okay";
	};
};

&spi2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi2_default>;

	/* Data SPI is 64MB in size */
	flash@0 {
		status = "okay";
		label = "config";
		spi-max-frequency = <50000000>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			u-boot-env@0 {
				reg = <0x0 0x40000>; /* 256KB at offset 0 */
				label = "u-boot-env";
			};

			rwfs@40000 {
				reg = <0x40000 0x1000000>; /* 16MB at offset 0x40000 */
				label = "rwfs";
			};

			log@1040000 {
				reg = <0x1040000 0x2800000>; /* 40MB at offset 0x1040000 */
				label = "log"; /* Move log to EMMC, make this unused */
			};
		};
	};
};

&uart1 {
	status = "okay";
};

&uart5 {
	/* BMC Debug Console */
	status = "okay";
};

&uart_routing {
	status = "okay";
};

/*
 * MAC1 (per schematics, 1-based MAC1-MAC4) of AST2600 connected to external PHY
 * This is "mac0" in zero-based DTS
 */
&mdio0 {
	status = "okay";
	/* P3809 U50 RTL8211FSI-CG RGMII-to-SGMII Ethernet PHY. */
	p3809_u50_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};
};

&mac0 {
	status = "okay";
	pinctrl-names = "default";
	phy-mode = "rgmii-rxid";
	max-speed = <1000>;
	phy-handle = <&p3809_u50_phy>;
	pinctrl-0 = <&pinctrl_rgmii1_default>;
};

/* Enable emmc */
&emmc_controller {
	status = "okay";
};

&emmc {
	non-removable;
	pinctrl-0 = <&pinctrl_emmcg9_default>;
	bus-width = <8>;
	max-frequency = <52000000>;
	clk-phase-mmc-hs200 = <9>, <225>;
};

/* Enable USB port A as device (via the virtual hub) to host */
&vhub {
	status = "okay";
	pinctrl-names = "default";
};

&video {
	status = "okay";
	memory-region = <&video_engine_memory>;
};

/*
 * USB 2.0 management topology on AST2600 port B:
 *
 *   U54 root hub
 *   |-- port 2: U20 OSFP hub
 *   |   |-- port 1: U3 CP2112
 *   |   |-- port 2: U59 shared CX9 SMA
 *   |   `-- port 3: U184 drive-midplane hub
 *   |       |-- port 1: U155 CP2112
 *   |       |-- port 2: U1 storage SMA
 *   |       `-- port 3: U2 storage SMA
 *   `-- port 3: P4218 U125 hub
 *       |-- port 1: P4218 U100 SMA
 *       |-- port 2: U216 CP2108
 *       |-- port 3: Vera USB MCTP or external USB-C through U1263
 *       `-- port 4: optional air-cooling endpoint
 */
&ehci1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* P3809 U54 USX2064 four-port root management USB hub. */
	p3809_u54_hub: hub@1 {
		reg = <1>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* OSFP U20 USX2064 hub for board and drive-midplane management. */
		osfp_u20_hub: hub@2 {
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;

			osfp_u3_cp2112: device@1 {
				reg = <1>;
			};

			osfp_u59_mcu: device@2 {
				reg = <2>;
			};

			/* Drive-midplane U184 USX2064 hub for the CP2112 and storage MCUs. */
			midplane_u184_hub: hub@3 {
				reg = <3>;
				#address-cells = <1>;
				#size-cells = <0>;

				midplane_u155_cp2112: device@1 {
					reg = <1>;
				};

				midplane_u1_mcu: device@2 {
					reg = <2>;
				};

				midplane_u2_mcu: device@3 {
					reg = <3>;
				};
			};
		};

		/* P4218 U125 USX2064 four-port management USB hub. */
		p4218_u125_hub: hub@3 {
			reg = <3>;
			#address-cells = <1>;
			#size-cells = <0>;

			p4218_u100_mcu: device@1 {
				reg = <1>;
			};
		};
	};
};

/* OSFP U3 CP2112 provides board FRU access and independent MCU recovery GPIOs. */
&osfp_u3_cp2112 {
	compatible = "usb10c4,ea90";

	osfp_u3_cp2112_i2c: i2c {
		#address-cells = <1>;
		#size-cells = <0>;

		/* OSFP U21 BR24G128FJ board FRU EEPROM. */
		osfp_u21_fru: eeprom@57 {
			compatible = "rohm,24c128", "atmel,24c128";
			reg = <0x57>;
			label = "osfp-fru";
		};
	};
};

/*
 * OSFP U59 MCXN556 manages both ConnectX-9 devices. Its USB composite
 * function provides MCTP plus LSTP I2C channels for the two CX GW0 buses.
 */
&osfp_u59_mcu {
	compatible = "usb0955,cf11";
	#address-cells = <2>;
	#size-cells = <0>;

	interface@2 {
		reg = <2 1>;
		#address-cells = <1>;
		#size-cells = <0>;

		osfp_u59_cx0_i2c: channel@1 {
			compatible = "nvidia,lstp-i2c";
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		osfp_u59_cx1_i2c: channel@2 {
			compatible = "nvidia,lstp-i2c";
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};

/* Midplane U155 CP2112 provides FRU/ISP access and recovery GPIOs for U1/U2. */
&midplane_u155_cp2112 {
	compatible = "usb10c4,ea90";
	gpio-controller;
	interrupt-controller;
	#gpio-cells = <2>;
	#interrupt-cells = <2>;
	gpio-line-names =
		"MIDP_MCU0_RST_L-O",
		"MIDP_MCU0_RECOVERY_L-O",
		"MIDP_MCU1_RST_L-O",
		"MIDP_MCU1_RECOVERY_L-O",
		"", "", "MIDP_GLOBAL_WP-O", "";

	midplane_u155_cp2112_i2c: i2c {
		#address-cells = <1>;
		#size-cells = <0>;

		/* Drive-midplane U156 BR24G128FJ FRU EEPROM. */
		midplane_u156_fru: eeprom@54 {
			compatible = "rohm,24c128", "atmel,24c128";
			reg = <0x54>;
			label = "midplane-fru";
		};

		/* Drive-midplane U190 PCA9546 MCU ISP mux. */
		midplane_u190_isp_mux: i2c-mux@70 {
			compatible = "nxp,pca9546";
			reg = <0x70>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};

/*
 * Midplane U1 MCXN556 is the USB MCTP endpoint for drives 0 through 7.
 * Its eight downstream SSD SMBus links are MCU-owned and are not LSTP buses.
 */
&midplane_u1_mcu {
	compatible = "usb0955,cf11";
};

/*
 * Midplane U2 MCXN556 is intended to manage populated drives 8 through 11.
 * The shared eight-link USB MCTP firmware has no LSTP buses; mapping is unresolved.
 */
&midplane_u2_mcu {
	compatible = "usb0955,cf11";
};

/*
 * P4218 U100 MCXN556 provides USB MCTP and bridges two downstream I3C endpoints.
 * LSTP has management and unsafe raw flash SPI only; SPI is omitted intentionally.
 */
&p4218_u100_mcu {
	compatible = "usb0955,cf11";
};

/* I2C1 is not populated; current P4218 MCU firmware has no SSIF LSTP channel. */
&i2c0 {
	status = "disabled";
};

/* I2C2 is not part of the CMX L10 management topology. */
&i2c1 {
	status = "disabled";
};

/* I2C3, P4218 MGMT0 */
&i2c2 {
	status = "okay";
	clock-frequency = <400000>;
	i2c-scl-clk-low-timeout-us = <32000>;
	i2c-tck-thddat-config = <0x0099EC00>;

	/* P4218 U1343 M24C64 BMC FRU EEPROM. */
	p4218_u1343_fru: eeprom@50 {
		compatible = "st,24c64", "atmel,24c64";
		reg = <0x50>;
		label = "p4218-fru";
	};
};

/* I2C4 is test-point-only on the SMM carrier. */
&i2c3 {
	status = "disabled";
};

/* I2C5 is test-point-only on the SMM carrier. */
&i2c4 {
	status = "disabled";
};

/* I2C6 serves SMM-local GPIO, temperature, and FRU devices. */
&i2c5 {
	status = "okay";
	clock-frequency = <400000>;
	i2c-scl-clk-low-timeout-us = <32000>;
	i2c-tck-thddat-config = <0x0099EC00>;

	/* SMM U43 CAT34C02 carrier FRU EEPROM. */
	smm_u43_fru: eeprom@50 {
		compatible = "catalyst,24c02", "atmel,24c02";
		reg = <0x50>;
		label = "smm-fru";
	};
};

/* I2C7 is test-point-only on the SMM carrier. */
&i2c6 {
	status = "disabled";
};

/* I2C8 is test-point-only on the SMM carrier. */
&i2c7 {
	status = "disabled";
};

/* I2C9 is an SSIF/test pair with no active target. */
&i2c8 {
	status = "disabled";
};

/*
 * I2C10
 * PDB
 */
&i2c9 {
	status = "okay";
	clock-frequency = <400000>;
	i2c-tck-thddat-config = <0x0099EC00>;

};

/*
 * I2C11
 * BMC FRU EEPROM
 * BMC Temp Sensor
 */
&i2c10 {
	status = "okay";
	clock-frequency = <400000>;
	i2c-tck-thddat-config = <0x0099EC00>;
	/* P3809 U43 CAT34C02 BMC FRU EEPROM. */
	p3809_u43_fru: eeprom@50 {
		compatible = "catalyst,24c02", "atmel,24c02";
		reg = <0x50>;
		label = "p3809-fru";
	};
};

/* I2C12 serves the SMM Ethernet switch management segment. */
&i2c11 {
	status = "ok";
	clock-frequency = <400000>;
};

/* I2C13 is test-point-only on the SMM carrier. */
&i2c12 {
	status = "disabled";
};

/* I2C14 is test-point-only on the SMM carrier. */
&i2c13 {
	status = "disabled";
};

/* I2C15 is a non-addressed SMM LED-control stuffing option. */
&i2c14 {
	status = "disabled";
};

/* I2C16 has only no-stuff reserve button aliases. */
&i2c15 {
	status = "disabled";
};

&jtag0 {
	status = "okay";
};

&jtag1 {
	status = "okay";
};

&rng1 {
	status = "okay";
};

&chassis {
	status = "okay";
};
