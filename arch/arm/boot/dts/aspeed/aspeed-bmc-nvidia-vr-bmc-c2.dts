// PCIe RC
&pcie0 {
    status = "okay";

    interrupts = <GIC_SPI 168 IRQ_TYPE_LEVEL_HIGH>;
};

&mctp0 {
    reg = <0x1e6e8000 0x1000>;
    interrupts-extended = <&gic GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>,
                          <&scu_ic0 ASPEED_AST2600_SCU_IC0_PCIE_PERST_HI_TO_LO>,
                          <&scu_ic0 ASPEED_AST2600_SCU_IC0_PCIE_PERST_LO_TO_HI>;
    interrupt-names = "mctp", "perst-lo", "perst-hi";
    memory-region = <&mctp0_reserved>;
    status = "okay";
};

&jtag0 {
    status = "okay";
};

&jtag1 {
    status = "okay";
};

&rng1 {
    status = "okay";
};

&chassis {
	status = "okay";
};
