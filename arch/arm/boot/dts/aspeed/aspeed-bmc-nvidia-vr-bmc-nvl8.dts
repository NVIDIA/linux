/dts-v1/;

#include "aspeed-g6.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>
#include <dt-bindings/i2c/i2c.h>
#include <dt-bindings/leds/common.h>

/ {
    model = "AST2600 VR NVL8 BMC";
    compatible = "aspeed,ast2600";

    aliases {
        serial2 = &uart3;
        serial4 = &uart5;

        i2c16 = &i2c_bf4_fru;            /* I2C2 (&i2c1) PCA9546 0x70 ch0: BF4 FRU */
        i2c17 = &i2c_bf4_fru_mux_ch1;    /* I2C2 (&i2c1) PCA9546 0x70 ch1: unused */
        i2c18 = &i2c_bf4_fru_mux_ch2;    /* I2C2 (&i2c1) PCA9546 0x70 ch2: unused */
        i2c19 = &i2c_bf4_fru_mux_ch3;    /* I2C2 (&i2c1) PCA9546 0x70 ch3: unused */

        i2c20 = &i2c_cx9_0_gw0;          /* I2C2 (&i2c1) PCA9546 0x73 ch0: CX9_0 GW0 */
        i2c21 = &i2c_cx9_1_gw0;          /* I2C2 (&i2c1) PCA9546 0x73 ch1: CX9_1 GW0 */
        i2c22 = &i2c_cx9_mux_ch2;        /* I2C2 (&i2c1) PCA9546 0x73 ch2: unused */
        i2c23 = &i2c_cx9_mux_ch3;        /* I2C2 (&i2c1) PCA9546 0x73 ch3: unused */

        i2c24 = &i2c_m2_riser_mgmt;      /* I2C9 (&i2c8) PCA9546 0x73 ch0: M.2 Riser cascade + PCA9536 0x41 */
        i2c25 = &i2c_i2c9_cascade_ch1;   /* I2C9 (&i2c8) PCA9546 0x73 ch1: unused */
        i2c26 = &i2c_i2c9_cascade_ch2;   /* I2C9 (&i2c8) PCA9546 0x73 ch2: unused */
        i2c27 = &i2c_cx9_rclk_buf;       /* I2C9 (&i2c8) PCA9546 0x73 ch3: LMK1104 CX9 Rclk buffer */

        i2c28 = &i2c_m2_0;               /* I2C9 (&i2c8) -> 0x73 ch0 -> 0x71 ch0: M.2 SSD_0 */
        i2c29 = &i2c_m2_1;               /* I2C9 (&i2c8) -> 0x73 ch0 -> 0x71 ch1: M.2 SSD_1 */
        i2c30 = &i2c_m2_riser_fru;       /* I2C9 (&i2c8) -> 0x73 ch0 -> 0x71 ch2: M.2 board FRU EEPROM 24512 @ 0x51 */
        i2c31 = &i2c_m2_riser_temp;      /* I2C9 (&i2c8) -> 0x73 ch0 -> 0x71 ch3: TMP411 temp sensor @ 0x4C */
    };

    chosen {
        stdout-path = &uart5;
        bootargs = "console=tty0 console=ttyS4,115200n8 earlyprintk";
    };

    memory@80000000 {
        device_type = "memory";
        reg = <0x80000000 0x80000000>;
    };

    reserved-memory {
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;

        vga_memory: framebuffer@9f000000 {
            reg = <0x9f000000 0x01000000>; /* 16M */
            no-map;
        };

        ramoops@a0000000 {
            compatible = "ramoops";
            reg = <0xa0000000 0x100000>; /* 1MB */
            record-size = <0x10000>; /* 64KB */
            max-reason = <2>; /* KMSG_DUMP_OOPS */
        };

        gfx_memory: framebuffer {
            compatible = "shared-dma-pool";
            size = <0x01000000>;
            alignment = <0x01000000>;
            reusable;
        };

        video_engine_memory: jpegbuffer {
            compatible = "shared-dma-pool";
            size = <0x02000000>;	/* 32M */
            alignment = <0x01000000>;
            reusable;
        };
    };

    leds {
        compatible = "gpio-leds";

        uid_led {
            gpios = <&gpio0 ASPEED_GPIO(S, 0) GPIO_ACTIVE_LOW>;
        };

        /*
         * No physical LED. The gpio-leds driver claims BMC_READY-O so
         * userspace can drive it via /sys/class/leds/bmc_ready_noled/brightness
         * (asserted by bmc_ready.sh once platform-init completes).
         */
        bmc_ready_noled {
            gpios = <&gpio0 ASPEED_GPIO(I, 3) (GPIO_ACTIVE_HIGH | GPIO_TRANSITORY)>;
        };
    };

    buttons {
        power-btn {
            gpio = <&gpio0 ASPEED_GPIO(V, 0) GPIO_ACTIVE_LOW>;
        };

        uid-btn {
            gpio = <&gpio0 ASPEED_GPIO(E, 3) GPIO_ACTIVE_LOW>;
        };
    };
};

