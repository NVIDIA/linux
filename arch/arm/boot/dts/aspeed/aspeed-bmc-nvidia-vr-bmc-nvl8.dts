    gpio-line-names =
        /*A0-A7*/
        "",
        "",
        "",
        "GPU_BASE_CEC_RECOV_N-O",
        "",
        "",
        "",
        "GPU_BASE_HMC_EROT_FATALERR_N-I",

        /*B0-B7*/
        "",
        "",
        "",
        "",
        "",
        "",
        "",
