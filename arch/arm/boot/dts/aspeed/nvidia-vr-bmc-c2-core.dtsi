    "EROT_AP_GNT-I",
    "",
    "",
    "PCB_TEMP_ALERT-I",
    "", "", "",

    /*W0-W7*/
    "", "", "", "", "", "", "", "",

    /*X0-X7*/
    "", "",
    "TPM_MUX_SEL-O",
    "", "", "", "", "",

    /*Y0-Y7*/
    "", "", "",
    "EMMC_RST-O",
    "","", "", "",

    /*Z0-Z7*/
    "","", "", "", "", "", "", "";
