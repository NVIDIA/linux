        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;
        gpio-line-names =
            "B1_M1_MCU_RESET_L-O",
            "B1_M1_MCU_RECOVERY_L-O",
            "B1_M1_SNN_U98A_P3",
            "B1_M1_SNN_U98A_P4",
            "B1_M1_SNN_U98A_P5",
            "B1_M1_SNN_U98A_P6",
            "B1_M1_SNN_U98A_P7",
            "B1_M1_SNN_U98A_P8",
            "B1_M1_SNN_U98A_P10",
            "B1_M1_SNN_U98A_P11",
            "B1_M1_USB_HMC_HUB_RST_L-O",
            "B1_M1_HPM_MCU_OK-I",
            "B1_M1_SNN_IST_BOOT_MODE1",
            "B1_M1_IST_COMPLETE_L-I",
            "B1_M1_IST_SYS_RST_L-O",
            "B1_M1_HMC_PRESENT_L-O";
    };

    // MGMT1 BOARD1, Expander @0x21
    exp15: pca9555@21 {
        compatible = "nxp,pca9555";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;

        #address-cells = <1>;
        #size-cells = <0>;
        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        vcc-supply = <&standby_power_regulator>;
        gpio-line-names =
            "B1_M1_CPU_FORCED_RECOVERY_L-B",
            "B1_M1_CPU_BOOT_DEV_SEL0-B",
            "B1_M1_CPU_BOOT_DEV_SEL1-B",
            "B1_M1_CPU_BOOT_DEV_SEL2-B",
            "B1_M1_SNN_CPU_BOOT_DEV_SEL3",
            "B1_M1_CPU_RECOVERY_TYPE0-B",
            "B1_M1_CPU_RECOVERY_TYPE1-B",
            "B1_M1_CPU_IST_BOOT-B",
            "B1_M1_CPU_BOOT_CHAIN0-B",
            "B1_M1_SNN_CPU_BOOT_CHAIN1",
            "B1_M1_SNN_CPU_BOOT_CHAIN2",
            "B1_M1_CPU_DIE_SEL0-B",
            "B1_M1_CPU_DIE_SEL1-B",
            "B1_M1_CPU_DIE_SEL2-B",
            "B1_M1_CPU_BOOT_COMPLETE-B",
            "B1_M1_NVJTAG_SEL_S-B";
    };
};

// EMMC group that excludes WP pin
&pinctrl {
    pinctrl_emmcg5_default: emmcg5_default {
        function = "EMMC";
        groups = "EMMCG5";
    };
};

