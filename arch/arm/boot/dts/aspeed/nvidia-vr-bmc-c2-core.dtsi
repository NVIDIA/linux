            "B0_M0_C1_SOCAMM_I2C_SEL-O",
            "B0_M0_EEPROM_POWER_DISABLE-O",
            "B0_M0_CPU_L0L1_RST_L_3V3-I",
            "B0_M0_CPU_L2_RST_L_3V3-I",
            "B0_M0_BRD_ID_0",
            "B0_M0_BRD_ID_1",
            "B0_M0_BMC_LEAK_TEST_L-O",
            "B0_M0_MCU_BMC_ALERT_L-I",
            "B0_M0_CPU_BOOT_COMPLETE_3V3-I",
