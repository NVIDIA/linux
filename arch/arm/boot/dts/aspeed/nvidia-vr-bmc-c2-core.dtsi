// I2C4 GPIO Expander
&i2c3 {
    // MGMT1 BOARD1, Expander @0x20
    exp14: pca9555@20 {
        compatible = "nxp,pca9555";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;

        #address-cells = <1>;
        #size-cells = <0>;
