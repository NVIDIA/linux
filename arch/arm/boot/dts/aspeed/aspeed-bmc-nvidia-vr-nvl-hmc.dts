            "BRD1_GPU_MCU_RESET_L_3V3-O",
            "BRD1_GPU_MCU_RECOVERY_L_3V3-O",
            "BRD1_THERM_OVERT_L-I",
            "BRD1_THERM_WARN_L-I",
            "BRD1_HMC_IST_PRE_RST_L-O",
            "BRD1_CPLD_READY-I",
            "BRD1_MODULE_PWR_GOOD-I",
            "BRD1_MCU_HMC_ALERT_L-I",
            "BRD1_USB_HMC_HUB_RST_L-O",
            "BRD1_HPM_MCU_OK-I",
            "BRD1_CPU0_SHDN_OK_L_3V3-I",
            "BRD1_CPLD_AUTH_FAIL_L-I",
            "BRD1_IST_SYS_RST_L-O",
            "BRD1_PWR_BRAKE_STATUS_L-I";
    };

    // IO Expander - initramfs rebinds driver after standby power ready
    exp1_brd1: tca9535@21 {
        compatible = "nxp,pca9535";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;
        interrupt-controller;
        #interrupt-cells = <2>;
        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(D, 7) IRQ_TYPE_LEVEL_LOW>;

        gpio-line-names =
            "BRD1_CPU_FORCED_RECOVERY_L-O",
            "BRD1_CPU_BOOT_DEV_SEL0-O",
            "BRD1_CPU_BOOT_DEV_SEL1-O",
            "BRD1_CPU_BOOT_DEV_SEL2-O",
            "BRD1_BOARD_ID_0-I",
            "BRD1_CPU_RECOVERY_TYPE0-O",
            "BRD1_CPU_RECOVERY_TYPE1-O",
            "BRD1_CPU_IST_BOOT_HMC-O",
            "BRD1_CPU_BOOT_CHAIN0-O",
            "BRD1_BOARD_ID_1-I",
            "BRD1_HMC_TO_MCU_I2C_EN-O",
            "BRD1_CPU_DIE_SEL0-O",
            "BRD1_CPU_DIE_SEL1-O",
            "BRD1_CPU_DIE_SEL2-O",
            "BRD1_CPU_BOOT_COMPLETE-I",
            "BRD1_IOX_JTAG_NVSEL-O";
    };
};

// I2C9
&i2c8 {
    status = "disabled";
};

// I2C10
&i2c9 {
    status = "okay";
};

// I2C11
&i2c10 {
    status = "okay";
    clock-frequency = <400000>;

    // Temp Sensor
    lm75@48 {
        compatible = "ti,tmp75";
        reg = <0x48>;
    };

    // HMC FRU EEPROM
    eeprom@50 {
        compatible = "atmel,24c02";
        reg = <0x50>;
        read-only;
    };
};

// I2C12
&i2c11 {
    status = "disabled";
};

// I2C13
&i2c12 {
    status = "disabled";
};

// I2C14
&i2c13 {
    status = "disabled";
};

// I2C15
&i2c14 {
    status = "disabled";
};

// I2C16
&i2c15 {
    status = "disabled";
};

/*&mctp {
    status = "okay";
};

&jtag0 {
    status = "okay";
};*/

// Enable network interface for QEMU
// TBD: We may want to remove for PROD build(s)
&mdio2 {
    status = "disabled";
    ethphy0: ethernet-phy@0 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <0>;
    };
};

&mac2 {
    status = "disabled";
    pinctrl-names = "default";
    phy-mode = "rgmii";
    max-speed = <1000>;
    phy-handle = <&ethphy0>;
    pinctrl-0 = <&pinctrl_rgmii3_default>;
};

// Enable emmc
&emmc_controller {
    status = "okay";
};

&emmc {
    non-removable;
    pinctrl-0 = <&pinctrl_emmcg9_default>;
    bus-width = <8>;
    max-frequency = <200000000>;
    clk-phase-mmc-hs200 = <9>, <225>;
};

&rng1 {
        status = "okay";
};

