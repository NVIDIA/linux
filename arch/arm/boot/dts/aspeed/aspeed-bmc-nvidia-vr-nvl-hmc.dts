        i2c-nack-retry-delay-us = <0>;
        i2c-nack-retry-addr = <0x52>;
    };

    // IO Expander - initramfs rebinds driver after standby power ready
    exp0_brd1: tca9535@20 {
        compatible = "nxp,pca9535";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
        interrupt-controller;
        #interrupt-cells = <2>;
