        interrupt-parent = <&gpio1>;
        interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;
        gpio-line-names =
            "PDB_STRAP-I",
            "STBY_POWER_EN-O",
            "STBY_PWR_OK-I",
            "",
            "",
            "MAIN_PWR_EN-O",
            "MAIN_PWR_OK-I",
