/* 36 (4*8+4) 1.8V GPIOs */
&gpio1 {
	gpio-line-names =

	/* A0-A7 */
		"", "", "", "", "", "", "", "",

	/* B0-B7 */
		"",
		"",
		"",
		"",
		"AP_EROT_REQ-O",
		"EROT_AP_GNT-I",
		"I2C_MGMT0_ALERT_L-I",
		"",

	/* C0-E3 */
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "";
};

/* I2C3 P4218 GPIO Expanders */
&i2c2 {
	/* P4218 U1132 TCA9535 GPIO bank 0 for power, thermal, and hub control. */
	p4218_u1132_gpio: pca9555@20 {
		compatible = "nxp,pca9555";
		reg = <0x20>;

		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio1>;
		interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;

		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names =
			"B0_SHDN_FORCE_L-O",
			"",
			"B0_THERM_OVERT_L-I",
			"B0_THERM_WARN_L-I",
			"B0_HPM_WP-O",
			"B0_USB_HUB0_RST_L-O",
			"B0_PRE_SYS_RST_L-O",
			"B0_LEAK_DETECT_ALERT_L-I",

			"B0_RUN_POWER_EN-O",
			"B0_RUN_POWER_PG-I",
			"B0_CPU_CHIPTHROT_L-I",
			"B0_SHDN_REQ_L-O",
			"B0_CPU_SHDN_OK_L-I",
			"B0_CPLD_READY-I",
			"B0_PWR_BRAKE_L-O",
			"B0_PWR_BRAKE_STATUS_L-I";
	};

	/* P4218 U1133 TCA9535 GPIO bank 1 for mux, SOCAMM, and status control. */
	p4218_u1133_gpio: pca9555@21 {
		compatible = "nxp,pca9555";
		reg = <0x21>;

		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio1>;
		interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;

		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names =
			"",
			"B0_HPM_MCU_OK-I",
			"B0_CPU_L0_RST_IND_L-I",
			"B0_SOCAMM_DAC_SEL0-O",
			"B0_SOCAMM_DAC_SEL1-O",
			"B0_C0_SOCAMM_I2C_SEL_R-O",
			"",
			"B0_EEPROM_POWER_DISABLE-O",

			"B0_L0L1_RST_L-I",
			"B0_L2_RST_L-I",
			"B0_BRD_ID_0-I",
			"B0_BRD_ID_1-I",
			"B0_LEAK_TEST_L-O",
			"B0_MCU_BMC_ALERT_L-I",
			"B0_CPU_BOOT_COMPLETE-I",
			"";
	};

	/* P4218 U1134 TCA9535 GPIO bank 2 for MCU recovery and board status. */
	p4218_u1134_gpio: pca9555@22 {
		compatible = "nxp,pca9555";
		reg = <0x22>;

		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio1>;
		interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;

		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names =
			"B0_HPM_MCU_RESET_L-O",
			"B0_HPM_MCU_REC_L-O",
			"B0_BMC_RTC_ALERT_L-I",
			"B0_BMC_RTC_CLR_L-O",
			"B0_CPU_RST_L-I",
			"",
			"",
			"B0_CPLD_READY-I",

			"B0_RUN_POWER_PG-I",
			"B0_MCU_ALERT_L-I",
			"",
			"B0_HPM_MCU_OK-I",
			"",
			"B0_CPLD_AUTH_FAIL-I",
			"",
			"B0_PWR_BRAKE_STATUS2_L-I";
	};

	/* P4218 U1131 TCA9535 GPIO bank 3 for CPU boot and JTAG control. */
	p4218_u1131_gpio: pca9555@23 {
		compatible = "nxp,pca9555";
		reg = <0x23>;

		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio1>;
		interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;

		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names =
			"B0_CPU_FORCED_RECOVERY_L-O",
			"B0_CPU_BOOT_DEV_SEL0-O",
			"B0_CPU_BOOT_DEV_SEL1-O",
			"B0_CPU_BOOT_DEV_SEL2-O",
			"",
			"B0_CPU_RECOVERY_TYPE0-O",
			"B0_CPU_RECOVERY_TYPE1-O",
			"B0_CPU_IST_BOOT_HMC-O",

			"B0_CPU_PREBOOT_DIAG-O",
			"",
			"B0_HPM_MCU_I2C_ENABLE-O",
			"B0_CPU_DIE_SEL0-O",
			"B0_CPU_DIE_SEL1-O",
			"B0_CPU_DIE_SEL2-O",
			"",
			"B0_NVJTAG_SEL-O";
	};
};

/* I2C6 SMM Carrier GPIO Expanders */
&i2c5 {
	/* SMM U73 TCA9535/TCA9555 GPIO expander for LEDs, buttons, and BMC power. */
	smm_u73_gpio: pca9555@20 {
		compatible = "nxp,pca9555";
		reg = <0x20>;

		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio1>;
		interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;

		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names =
			"",
			"",
			"",
			"SMM_FRU_WP-O",
			"",
			"",
			"BMC_SELF_PWR_CYCLE-O",
			"EEDO_LED2-O",

			"PWR_LED_L-O",
			"PWR_BTN_L-I",
			"UID_LED_L-O",
			"UID_BTN_L-I",
			"FAULT_LED_L-O",
			"",
			"",
			"WARN_LED_L-O";
	};

	/* SMM U74 TCA9535 GPIO expander for switch, tray, and USB controls. */
	smm_u74_gpio: pca9555@21 {
		compatible = "nxp,pca9555";
		reg = <0x21>;

		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio1>;
		interrupts = <ASPEED_GPIO(B, 6) IRQ_TYPE_LEVEL_LOW>;

		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names =
			"",
			"",
			"",
			"",
			"",
			"",
			"SW_NRESET_L-O",
			"",

			"",
			"",
			"PDB_TRAY_RST-O",
			"HOST_RDY_PWR_EN-O",
			"",
			"",
			"",
			"";
	};
};

/* EMMC group that excludes WP & CD pin */
&pinctrl {
	pinctrl_emmcg9_default: emmcg9_default {
		function = "EMMC";
		groups = "EMMCG9";
	};
};
